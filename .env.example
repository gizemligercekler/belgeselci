# GEMINI_API_KEY: Required for server-side Gemini AI API calls (default fallback).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PEXELS_API_KEY: Optional server-side fallback for 16:9 stock video search.
PEXELS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
